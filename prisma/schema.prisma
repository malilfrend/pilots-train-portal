generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("STORAGE_DATABASE_URL")
  directUrl = env("STORAGE_DATABASE_URL")
}

enum UserRole {
  PILOT
  INSTRUCTOR
  SUPER_ADMIN
}

enum CompetencyCode {
  PRO           // Procedures
  COM           // Communication
  FPA           // Flight Path Automation
  FPM           // Flight Path Manual
  LTW           // Leadership ans Teamwork
  PSD           // Problem Solving and Decision
  SAW           // Situational Awareness
  WLM           // Workload Management
}

// Базовый профиль пользователя
model UserProfile {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  password      String
  firstName     String
  lastName      String
  birthDate     DateTime
  role          UserRole
  flightHours   Int?          // Общий налёт (часы)
  aircraftType  String?       // Тип воздушного судна
  position      String?       // Должность
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Связи с конкретными ролями
  pilot         Pilot?
  instructor    Instructor?
  superAdmin    Boolean       @default(false)
}

// Модель пилота
model Pilot {
  id              Int                @id @default(autoincrement())
  profile         UserProfile        @relation(fields: [profileId], references: [id])
  profileId       Int                @unique  // Один профиль - один пилот

  pilot1Sessions  Session[]          @relation("Pilot1Sessions")
  pilot2Sessions  Session[]          @relation("Pilot2Sessions")
  sessionScores   SessionScore[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// Модель инструктора
model Instructor {
  id                  Int                @id @default(autoincrement())
  profile             UserProfile        @relation(fields: [profileId], references: [id])
  profileId           Int                @unique  // Один профиль - один инструктор
  sessions            Session[]          // Сессии, проведённые инструктором
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// Тренажёрная сессия (immutable после создания)
model Session {
  id              Int               @id @default(autoincrement())
  instructor      Instructor        @relation(fields: [instructorId], references: [id])
  instructorId    Int
  pilot1          Pilot             @relation("Pilot1Sessions", fields: [pilot1Id], references: [id])
  pilot1Id        Int
  pilot2          Pilot             @relation("Pilot2Sessions", fields: [pilot2Id], references: [id])
  pilot2Id        Int
  totalTime       Int               // T в минутах
  totalValue      Int               // сумма v_k по упражнениям сценария
  date            DateTime          @default(now())
  isLegacy        Boolean           @default(false) // backfill из старой таблицы оценок
  createdAt       DateTime          @default(now())

  scores          SessionScore[]
  exercises       SessionExercise[]

  @@index([pilot1Id])
  @@index([pilot2Id])
  @@index([instructorId])
  @@index([date])
}

// Оценка пилота по компетенции в рамках конкретной сессии
model SessionScore {
  id              Int               @id @default(autoincrement())
  session         Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       Int
  pilot           Pilot             @relation(fields: [pilotId], references: [id])
  pilotId         Int
  competencyCode  CompetencyCode
  score           Int               // 2..5
  comment         String?

  @@unique([sessionId, pilotId, competencyCode])
  @@index([pilotId, competencyCode])
}

// Снапшот упражнения, выполненного в сессии
model SessionExercise {
  id              Int               @id @default(autoincrement())
  session         Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       Int
  order           Int               // порядок в финальном списке
  exercise        Exercise          @relation(fields: [exerciseId], references: [id])
  exerciseId      Int

  name            String
  executionTime   Int
  value           Int
  pilot           Int?              // 1 | 2, кому рекомендован PF
  role            String?           // 'PF' | 'PM'
  forBothPilots   Boolean           @default(false) // упражнение одинаково ценно обоим

  @@unique([sessionId, order])
  @@index([exerciseId])
}

// Упражнение со связкой с компетенциями
model Exercise {
  /// Авто‑инкрементный уникальный идентификатор упражнения
  id          Int                       @id @default(autoincrement())

  /// Название упражнения
  name        String

  /// Время выполнения упражнения (в минутах)
  executionTime Int?

  /// Связь с компетенциями, которые развивает это упражнение
  competencies ExerciseCompetency[]

  sessionExercises SessionExercise[]

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

/// Таблица‑связка для many‑to‑many между Exercise и enum’ом CompetencyCode
model ExerciseCompetency {
  exercise        Exercise             @relation(fields: [exerciseId], references: [id])
  exerciseId      Int

  /// Одна из компетенций из enum CompetencyCode
  competencyCode  CompetencyCode

  /// Композитный первичный ключ, чтобы одна и та же пара не дублировалась
  @@id([exerciseId, competencyCode])
  /// Индекс для ускорения выборок по компетенции (опционально)
  @@index([competencyCode])
}